# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***

# ── Postgres connection (Project Settings → Database) ─────────────
# Use the Session Pooler URI (port 5432 via the pooler host) or the
# direct connection URI. See SETUP.md for exact instructions.
DATABASE_URL=postgresql://postgres.XXXX:***@aws-0-REGION.pooler.supabase.com:5432/postgres

# Server-only storage access used by background media generation/publishing.
# Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bearer secret for /api/cron/publish and /api/cron/maintenance.
# Both refuse to run when unset. Deploy vercel.json to activate the schedules.
CRON_SECRET=
# Exact comma-separated custom AI API base URLs. Catalog defaults and canonical
# Cloudflare Workers AI account endpoints need no entry. If an older deployment
# still needs explicit Cloudflare entries, append BOTH account-specific bases
# without replacing existing endpoints:
# https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai,https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
# Never put API tokens in this variable.
AI_ALLOWED_BASE_URLS=
# A persistent Node deployment runs pg-boss workers automatically.
# Set true only on a persistent worker host when VERCEL is also set.
ENABLE_BACKGROUND_WORKER=false
# Read-only UI/build verification: skips startup workers and credential migration.
# Do not leave true on the host responsible for background jobs.
DISABLE_BACKGROUND_WORKER=false

# ── Meta integration (M4) ─────────────────────────────────────────
META_APP_ID=951827574651692
META_APP_SECRET=
# If your app uses Facebook Login for Business (new Meta wizard), create a
# Configuration with the 5 publishing permissions and paste its ID here.
META_LOGIN_CONFIG_ID=3422f82840cee07470f13b440b96dba1
ENCRYPTION_KEY=64-hex-chars

# ── Buffer integration (Buffer publishing provider) ───────────────
# OAuth for the Buffer publishing provider (buffer.com/developers).
# Optional until the provider is enabled; used by /api/buffer/connect.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Optional OAuth scope override (default: posts:read posts:write account:read offline_access)
# BUFFER_OAUTH_SCOPES=posts:read posts:write account:read offline_access

# Optional AI Chat payload budgets; JSON overrides: default -> provider -> provider/model.
# Use actual account/gateway request/TPM limits, not only the model context size.
# See docs/AI_CHAT_CONTEXT.md. Omit to use conservative application budgets.
QURTIZ_CHAT_LIMITS_JSON=
# Optional internal chat budget diagnostics in production (counts only; never prompt data).
QURTIZ_CHAT_BUDGET_DEBUG=

# ── Brave Search (built-in platform research service) ───────────────
# ONE shared project-level key powers live web research for EVERY user
# and workspace through the internal ResearchService (web_search agent
# tool, Research Lab grounding, trend suggestions). Get a key at
# https://brave.com/search/api/.
# SERVER-ONLY: never next_public, never log it, never store it in any
# Supabase user/workspace table — it is read exclusively from this
# environment by src/lib/research/brave.ts.
# Missing or invalid key = research tools degrade gracefully to an
# honest "live research unavailable" result; AI Chat keeps working.
BRAVE_SEARCH_API_KEY=
# Optional tuning (safe defaults shown):
# BRAVE_SEARCH_MAX_QPS=1                 # global shared-key guard (Brave free tier = 1/s)
# BRAVE_SEARCH_CACHE_TTL_SECONDS=900     # anonymous public-result cache TTL
# BRAVE_SEARCH_DEFAULT_REGION=US         # Brave `country` default
# BRAVE_SEARCH_DEFAULT_LANGUAGE=en       # Brave `search_lang` default
# Optional per-plan research allowances (JSON), overrides defaults:
# {"free":{"perMinute":6,"perMonthLive":300},"pro":{"perMinute":20,"perMonthLive":3000}}
QURTIZ_RESEARCH_LIMITS_JSON=
